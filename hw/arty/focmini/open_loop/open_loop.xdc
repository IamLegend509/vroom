# Open-loop top: A0 only, full-duplex UART, external I2C pull-ups.
set_property -dict { PACKAGE_PIN E3 IOSTANDARD LVCMOS33 } [get_ports {clk}]
set_property -dict { PACKAGE_PIN D9 IOSTANDARD LVCMOS33 } [get_ports {reset_button}]
set_property -dict { PACKAGE_PIN G13 IOSTANDARD LVCMOS33 } [get_ports {pwm_a}]
set_property -dict { PACKAGE_PIN B11 IOSTANDARD LVCMOS33 } [get_ports {pwm_b}]
set_property -dict { PACKAGE_PIN A11 IOSTANDARD LVCMOS33 } [get_ports {pwm_c}]
set_property -dict { PACKAGE_PIN D12 IOSTANDARD LVCMOS33 } [get_ports {enable}]
set_property -dict { PACKAGE_PIN D13 IOSTANDARD LVCMOS33 } [get_ports {reset_n}]
set_property -dict { PACKAGE_PIN B18 IOSTANDARD LVCMOS33 } [get_ports {sleep_n}]
set_property -dict { PACKAGE_PIN A18 IOSTANDARD LVCMOS33 } [get_ports {fault_n}]
set_property -dict { PACKAGE_PIN E15 IOSTANDARD LVCMOS33 } [get_ports {as5600_scl}]
set_property -dict { PACKAGE_PIN E16 IOSTANDARD LVCMOS33 } [get_ports {as5600_sda}]
set_property -dict { PACKAGE_PIN C6 IOSTANDARD LVCMOS33 } [get_ports {vaux4_p}]
set_property -dict { PACKAGE_PIN C5 IOSTANDARD LVCMOS33 } [get_ports {vaux4_n}]
set_property -dict { PACKAGE_PIN D10 IOSTANDARD LVCMOS33 } [get_ports {uart_tx}]
set_property -dict { PACKAGE_PIN H5 IOSTANDARD LVCMOS33 } [get_ports {led[0]}]
set_property -dict { PACKAGE_PIN J5 IOSTANDARD LVCMOS33 } [get_ports {led[1]}]
set_property -dict { PACKAGE_PIN T9 IOSTANDARD LVCMOS33 } [get_ports {led[2]}]
set_property -dict { PACKAGE_PIN T10 IOSTANDARD LVCMOS33 } [get_ports {led[3]}]
set_property -dict { PACKAGE_PIN A9 IOSTANDARD LVCMOS33 } [get_ports {uart_rx}]
create_clock -name board_clk -period 10.000 [get_ports clk]
set_property SLEW SLOW [get_ports {pwm_a pwm_b pwm_c enable reset_n sleep_n uart_tx led[*]}]
set_property DRIVE 8 [get_ports {pwm_a pwm_b pwm_c enable reset_n sleep_n uart_tx led[*]}]
# Asynchronous board inputs: exempt ONLY the first synchronizer flip-flop.
set_false_path -from [get_ports reset_button] -to [get_pins -hier -regexp {.*button_sync_reg\[0\]/D}]
set_false_path -from [get_ports fault_n] -to [get_pins -hier -regexp {.*fault_telemetry_reg\[0\]/D}]
set_false_path -from [get_ports as5600_scl] -to [get_pins -hier -regexp {.*scl_sync_reg\[0\]/D}]
set_false_path -from [get_ports as5600_sda] -to [get_pins -hier -regexp {.*sda_sync_reg\[0\]/D}]
set_false_path -from [get_ports uart_rx] -to [get_pins -hier -regexp {.*rx_sync_reg\[0\]/D}]
set_false_path -from [get_ports fault_n] -to [get_pins -hier -regexp {.*fault_level_reg\[0\]/D}]
# Asynchronous sticky fault capture: only its asynchronous PRE input is exempt.
set_false_path -from [get_ports fault_n] -to [get_pins -hier -regexp {.*fault_capture_reg/PRE}]
# nFAULT has a deliberate direct kill path to drive outputs; bound propagation.
set_max_delay -datapath_only 20 -from [get_ports fault_n] -to [get_ports {pwm_a pwm_b pwm_c enable reset_n sleep_n}]
# Slow asynchronous interfaces: bound FPGA output propagation to 20ns.
set_max_delay -datapath_only 20 -from [all_registers -clock board_clk] -to [get_ports {as5600_scl as5600_sda uart_tx led[*] pwm_a pwm_b pwm_c enable reset_n sleep_n}]
set_property BITSTREAM.CONFIG.UNUSEDPIN Pullnone [current_design]
set_property CFGBVS VCCO [current_design]
set_property CONFIG_VOLTAGE 3.3 [current_design]
